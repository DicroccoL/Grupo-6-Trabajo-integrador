<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eco Vintage - Cargar Producto</title>
  <link rel="stylesheet" href="/assets/inicio.css">
</head>
<body>

  <nav class="navbar">
    <div class="nav-brand">
      <img src="/img/logo.png" alt="Logo">
      <div>
        <h1>Eco Vintage</h1>
        <span class="admin-indicator-text">⚡ Panel de Administración</span>
      </div>
    </div>
    <div class="nav-actions">
      <a href="/admin" class="carrito-btn" style="text-decoration: none;">⬅️ Volver al Panel</a>
    </div>
  </nav>

  <div class="admin-layout" style="grid-template-columns: 1fr; max-width: 450px; margin: 120px auto 20px auto;">
    <aside class="admin-card">
      <h2>➕ Cargar Nuevo Producto</h2>
      
      <form action="/admin/agregar-producto" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>Nombre del Producto</label>
          <input type="text" name="nombre" placeholder="Ej: Campera Denim Retro" required>
        </div>
        
        <div class="form-group">
          <label>Precio ($)</label>
          <input type="number" name="precio" placeholder="Ej: 14500" required>
        </div>
        
        <div class="form-group">
          <label>Stock Disponible</label>
          <input type="number" name="stock" value="1" required>
        </div>
        
        <div class="form-group">
          <label>Descripción</label>
          <textarea name="descripcion" rows="2" placeholder="Detalles de la prenda..." style="width:100%; padding:8px; border-radius:4px; border:1px solid #ccc; resize:none; font-family:sans-serif;"></textarea>
        </div>
        
        <div class="form-group">
          <label>Foto de la Prenda</label>
          <input type="file" name="imagen" accept="image/*" required>
        </div>
        
        <button type="submit" class="btn-admin-action" style="width: 100%; cursor: pointer;">Guardar Producto</button>
      </form>
    </aside>
  </div>

  <footer class