<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eco Vintage - Catálogo</title>
    <link rel="stylesheet" href="/assets/inicio.css">
</head>
<body>

<div class="container">

    <nav class="navbar">
        <div class="nav-brand">
            <img src="/img/logo.png" alt="Logo">
            <div class="brand-text">
                <h1>Eco Vintage</h1>
                <span>Indumentaria & Calzado</span>
            </div>
        </div>

        <div class="nav-actions">
            <button class="carrito-btn" id="btn-ir-carrito">
               🛒 <span class="carrito-count" id="contador-carrito">0</span>
            </button>

            <div class="user-box">
                <div class="avatar" id="avatarUsuario">--</div>
                <div class="user-info">
                    <span class="welcome">Bienvenido</span>
                    <strong id="nombreUsuario">Cargando...</strong>
                </div>
            </div>
        </div>
    </nav>

    <section class="filtros">
        <button class="activo" id="btn-todos">Todos</button>
        <button id="btn-indumentaria">Indumentaria</button>
        <button id="btn-calzado">Calzado</button>
    </section>

    <section class="productos-grid" id="contenedor-productos">
        <% if (productos && productos.length > 0) { %>
            <% productos.forEach(producto => { %>
                <div class="producto-card" data-categoria="<%= producto.categoria %>">
                    <img src="/img/<%= producto.imagen_url %>" alt="<%= producto.nombre %>" onerror="this.onerror=null; this.src='/img/default.png';">
                    <h3><%= producto.nombre %></h3>
                    <p class="categoria"><%= producto.categoria %></p>
                    <p class="precio">$<%= producto.precio %></p>
                    <p class="stock">Disponibles: <%= producto.stock %></p>
                    <button class="btn-agregar" 
                            data-id="<%= producto.id %>" 
                            data-nombre="<%= producto.nombre %>" 
                            data-precio="<%= producto.precio %>"
                            data-categoria="<%= producto.categoria || 'General' %>">
                        Agregar al carrito
                    </button>
                </div>
            <% }) %>
        <% } else { %>
            <p class="no-productos">No hay productos disponibles en este momento.</p>
        <% } %>
    </section>

</div>
    <footer class="main-footer">
        <p>© 2026 Eco Vintage - Grupo 6. Integrantes: Tiago Esposito y Lucas Di Crocco.</p>
    </footer>


<script src="/js/theme.js"></script>
<script src="/js/inicio.js"></script>
</body>
</html>