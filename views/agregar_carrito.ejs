<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eco Vintage - <%= (typeof esEdicion !== 'undefined' && esEdicion) ? 'Editar Producto' : 'Cargar Producto' %></title>
  <link rel="icon" href="/img/logo.png" type="image/png">
  <link rel="stylesheet" href="/assets/inicio.css">
</head>
<body>

  <nav class="navbar">
    <div class="nav-brand">
      <img src="/img/logo.png" alt="Logo">
      <div>
        <h1>Eco Vintage</h1>
        <span class="admin-indicator-text">⚡ Panel de Administración</span>
      </div>
    </div>
    <div class="nav-actions">
      <a href="/admin" class="carrito-btn" style="text-decoration: none;">⬅️ Volver al Panel</a>
    </div>
  </nav>

  <div class="admin-layout" style="grid-template-columns: 1fr; max-width: 450px; margin: 120px auto 20px auto;">
    <aside class="admin-card">
      <h2><%= (typeof esEdicion !== 'undefined' && esEdicion) ? '✏️ Editar Producto' : '➕ Cargar Nuevo Producto' %></h2>
      
      <form action="<%= (typeof esEdicion !== 'undefined' && esEdicion) ? '/admin/editar-producto/' + producto.id : '/admin/agregar-producto' %>" method="POST" enctype="multipart/form-data">
        
        <% if (typeof esEdicion !== 'undefined' && esEdicion) { %>
          <input type="hidden" name="id" value="<%= producto.id %>">
        <% } %>

        <div class="form-group">
          <label>Nombre del Producto</label>
          <input type="text" name="nombre" placeholder="Ej: Campera Denim Retro" value="<%= (typeof producto !== 'undefined') ? producto.nombre : '' %>" required>
        </div>
        
        <div class="form-group">
          <label>Precio ($)</label>
          <input type="number" name="precio" placeholder="Ej: 14500" value="<%= (typeof producto !== 'undefined') ? producto.precio : '' %>" required>
        </div>
        
        <div class="form-group">
          <label>Stock Disponible</label>
          <input type="number" name="stock" value="<%= (typeof producto !== 'undefined') ? producto.stock : '1' %>" required>
        </div>
        
        <div class="form-group">
          <label>Descripción</label>
          <textarea name="descripcion" rows="2" placeholder="Detalles de la prenda..." style="width:100%; padding:8px; border-radius:4px; border:1px solid #ccc; resize:none; font-family:sans-serif;"><%= (typeof producto !== 'undefined') ? producto.descripcion : '' %></textarea>
        </div>
        
        <div class="form-group">
          <label>Categoria</label>
          <select name="categoria" required style="width:100%; padding:12px; border-radius:8px; border:1px solid #ccc; font-size:16px;">
            <option value="Indumentaria" <%= (typeof producto !== 'undefined' && producto.categoria === 'Indumentaria') ? 'selected' : '' %>>Indumentaria</option>
            <option value="Calzado" <%= (typeof producto !== 'undefined' && producto.categoria === 'Calzado') ? 'selected' : '' %>>Calzado</option>
          </select>
        </div>

        <div class="form-group">
          <label>Foto de la Prenda <%= (typeof esEdicion !== 'undefined' && esEdicion) ? '(Opcional si no deseas cambiarla)' : '' %></label>
          <input type="file" name="imagen" accept="image/*" <%= (typeof esEdicion !== 'undefined' && esEdicion) ? '' : 'required' %>>
        </div>
       
        <button type="submit" class="btn-admin-action" style="width: 100%; cursor: pointer;">
          <%= (typeof esEdicion !== 'undefined' && esEdicion) ? 'Guardar Cambios' : 'Guardar Producto' %>
        </button>
      </form>
    </aside>
  </div>

  <footer class="main-footer">
    <p>© 2026 Eco Vintage - Grupo 6. Panel de Gestión Exclusivo.</p>
  </footer>

</body>
</html>